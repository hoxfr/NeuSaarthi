# Copy this file to .env for local development (never commit the real .env).
# On Render/Railway/etc, set these as dashboard environment variables instead.

# Fast2SMS API key used by server.js to send OTPs. Get one at https://www.fast2sms.com
FAST2SMS_KEY=your_fast2sms_api_key_here

# Sarvam AI API key used by server.js for Hindi conversational chat + neural TTS.
# Get one at https://www.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
